# Copy this file to .env.local and fill in your real keys.
# .env.local is gitignored.

# Required
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — per-agent model overrides (defaults live in lib/llm.ts)
# LLM_INTAKE_MODEL=gpt-5
# LLM_DAMAGE_MODEL=gemini-3.1-pro
# LLM_DAMAGE_FALLBACK_MODEL=gpt-5
# LLM_COVERAGE_MODEL=gpt-5
# LLM_NBA_MODEL=gpt-5
# LLM_MESSAGE_MODEL=gpt-5

# Optional — voice synthesis. gpt-4o-mini-tts is the default.
# Voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar, nova.
# LLM_TTS_MODEL=gpt-4o-mini-tts
# LLM_TTS_VOICE=nova
